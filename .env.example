# Default AI Brain Provider: gemini | deepseek | local | mock
LLM_PROVIDER="gemini"

# GEMINI_API_KEY: Automatically injected by AI Studio or set locally
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

# DeepSeek LLM API (OpenAI-compatible)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Local OpenAI-Compatible LLM Server (Ollama / LM Studio / llama.cpp)
LOCAL_BASE_URL="http://localhost:11434/v1"
LOCAL_MODEL="qwen2.5:7b"

# Token Budget & Execution Safety
DAILY_TOKEN_BUDGET="500000"
DRY_RUN="true"

# Public Web Search Providers for Lead Hunter (optional, falls back to DuckDuckGo / Simulation)
SEARCH_TAVILY_API_KEY=""
SEARCH_SERPER_API_KEY=""

# Zalo OA & Worker Bridge (used when running full local /worker)
ZALO_OA_APP_ID=""
ZALO_OA_SECRET_KEY=""
ZALO_OA_REFRESH_TOKEN=""
VAULT_SECRET="replace-with-32-byte-random-hex-secret"
WORKER_WS_URL="http://localhost:4100"

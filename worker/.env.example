PORT=4100
DRY_RUN=true
HEADLESS=true

# Shared Multi-Provider AI Brain Configuration
# LLM_PROVIDER: gemini | deepseek | local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b

# 32-byte hex or strong passphrase for AES-256-GCM Credential Vault
VAULT_SECRET=change-this-to-a-32-char-secret-key-now

# SQLite via Prisma
DATABASE_URL="file:./dev.db"

# Zalo Official Account (OA)
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_CEO_USER_ID=
ZALO_WEBHOOK_SECRET=

# SMTP Email Channel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Company Vietnam <sales@aicompany.vn>"

# Telegram Fallback Channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CEO_CHAT_ID=
